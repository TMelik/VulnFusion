# Optional LLM duplicate-resolution settings for local development.
# Copy this file to .env and replace placeholders with your own values.
VULN_MANAGER_LLM_API_KEY="your_api_key_here"
VULN_MANAGER_LLM_API_URL="https://api.example.com/openai/v1/chat/completions"
VULN_MANAGER_LLM_MODEL="your_model_name"

# Optional runtime tuning
# VULN_MANAGER_DUPLICATE_MODE=llm
# VULN_MANAGER_LLM_TIMEOUT=15
# VULN_MANAGER_LLM_DEBUG=false
# VULN_MANAGER_LLM_CACHE_ENABLED=true

# Optional DefectDojo upload settings.
# The API token should be the raw key only, without a leading "Token " prefix.
# VULN_MANAGER_DEFECTDOJO_URL=https://dojo.example
# VULN_MANAGER_DEFECTDOJO_API_TOKEN=your_defectdojo_api_token
# VULN_MANAGER_DEFECTDOJO_UPLOAD_MODE=raw-per-scan
# VULN_MANAGER_DEFECTDOJO_PRODUCT_TYPE=Research and Development
# VULN_MANAGER_DEFECTDOJO_PRODUCT=Test
# VULN_MANAGER_DEFECTDOJO_ENGAGEMENT=Test engagment
# VULN_MANAGER_DEFECTDOJO_TEST_ID=
# VULN_MANAGER_DEFECTDOJO_ENGAGEMENT_ID=
# VULN_MANAGER_DEFECTDOJO_TEST_TITLE=Vuln Manager merged findings
# VULN_MANAGER_DEFECTDOJO_MINIMUM_SEVERITY=Info
# VULN_MANAGER_DEFECTDOJO_ENVIRONMENT=Development
# true asks DefectDojo's reimport endpoint to create missing context.
# Set false to require Product Type / Product / Engagement to already exist.
# VULN_MANAGER_DEFECTDOJO_AUTO_CREATE_CONTEXT=true
# VULN_MANAGER_DEFECTDOJO_DO_NOT_REACTIVATE=false
# VULN_MANAGER_DEFECTDOJO_CLOSE_OLD_FINDINGS=false
# VULN_MANAGER_DEFECTDOJO_BACKGROUND_IMPORT=false
# VULN_MANAGER_DEFECTDOJO_STRICT_NAMES=false
# VULN_MANAGER_DEFECTDOJO_VERIFY_TLS=true
# VULN_MANAGER_DEFECTDOJO_SCAN_TYPE_NMAP=Nmap Scan
# VULN_MANAGER_DEFECTDOJO_SCAN_TYPE_NUCLEI=Nuclei Scan
# VULN_MANAGER_DEFECTDOJO_SCAN_TYPE_WAPITI=Wapiti Scan
# VULN_MANAGER_DEFECTDOJO_SCAN_TYPE_NIKTO=Nikto Scan
# VULN_MANAGER_DEFECTDOJO_SCAN_TYPE_ZAP=ZAP Scan
